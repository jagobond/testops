
# The board and the ticket files are authored on main; when a feature branch merges
# main, take the incoming version rather than a conflict nobody needs to resolve.
factory/TICKETS.md merge=board
factory/tickets/*.md merge=board

# Rendered pages are compared byte-for-byte with these fixtures (TESTOPS-38 AC2, TESTOPS-44 AC5).
# Git must not rewrite their line endings on checkout, or the comparison measures the checkout
# rather than the render: with core.autocrlf=true the fixture came back CRLF and the test failed
# against a page the build renders with LF.
tests/fixtures/projects_services/*.html -text
